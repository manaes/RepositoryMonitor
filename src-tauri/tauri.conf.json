{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepositoryMonitor",
  "version": "1.0.3",
  "identifier": "com.dgitx.repositorymonitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepositoryMonitor",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/manaes/RepositoryMonitor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOUFBOTVCMENFQkU1Q0EKUldUSzVlc01XNm1hMm14UytkbUVuektOT1NLd3pobmhVNEltNXFKQ2FtM1VqamNnSTV6UXQvdjIK"
    }
  }
}
